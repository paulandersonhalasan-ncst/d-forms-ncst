// This is your Prisma schema file,
// learn more about it in the docs: npx prisma generate

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid()) // Random secure ID (UUID)
  employee_id   String
  email         String         @unique
  password      String
  fname         String
  lname         String
  role          Role           @default(Staff)
  branch        SystemBranch   @default(MAIN)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  //department relations
  departmentCode  String
  department      Department     @relation(fields: [departmentCode], references: [code], onDelete: Restrict, onUpdate: Cascade)

  //notif relations
  received_notif  Notification[] @relation("notif_rcpt")
  sent_notif      Notification[] @relation("notif_sndr")

  //login sessions
  last_login        DateTime?
  login_logs        LoginLog[]

  //forgot password flag
  forgot_password   Boolean      @default(false)

  //activity logs
  activity_logs ActivityLog[]
}

model Department {
  id        String   @id @default(uuid())
  code      String   @unique //(e.g., "ITO", "CSD", "HRD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  //pabalik na relationship to User (1 departament, maraming users ang pwede nakatali)
  users     User[]
}

model ActivityLog {
  id           String   @id @default(uuid())
  userId       String?  // Pwedeng null kung hindi pa naka-login (hal. Failed login attempt)
  email        String?  // Para madaling basahin kahit nabura na yung user
  action       String   // Halimbawa: "LOGIN_SUCCESS", "LOGOUT", "USER_CREATE", "DEPT_UPDATE", "CHANGE_PASSWORD"
  details      String?  // Mas madetalyeng kwento (e.g., "Created user: juan@email.com", "Updated Dept: ITO to IT_NEW")
  ipAddress    String?
  createdAt    DateTime @default(now())

  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

enum Role {
  Staff
  OIC
  DepartmentHead
  SuperUser
  Admin
}

enum SystemBranch {
  MAIN
  IMUS
  NASTECH
  SHS
}

// notif table (useswr for fetch)
model Notification {
  id          String   @id @default(uuid())
  title       String
  message     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  // notif receipient
  recipientId String
  recipient   User     @relation("notif_rcpt", fields: [recipientId], references: [id], onDelete: Cascade)

  // notif sender
  senderId    String
  sender      User     @relation("notif_sndr", fields: [senderId], references: [id], onDelete: Cascade)
}

model LoginLog {
  id           Int          @id @default(autoincrement())
  userId       String?
  email        String?
  status       LoginStatus  @default(SUCCESS)
  ip_address   String?
  attempted_at DateTime     @default(now())

  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum LoginStatus {
  SUCCESS
  FAILURE
}