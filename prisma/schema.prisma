// This is your Prisma schema file,
// learn more about it in the docs: npx prisma generate

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid()) // Random secure ID (UUID)
  employee_id   String
  email         String         @unique
  password      String
  fname         String
  lname         String
  role          Role           @default(Staff)
  branch        SystemBranch   @default(MAIN)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  //department relations
  departmentCode  String
  department      Department     @relation(fields: [departmentCode], references: [code], onDelete: Restrict, onUpdate: Cascade)

  //notif relations
  received_notif  Notification[] @relation("notif_rcpt")
  sent_notif      Notification[] @relation("notif_sndr")

  //login sessions
  last_login        DateTime?
  login_logs        LoginLog[]

  //forgot password flag
  forgot_password   Boolean      @default(false)
  resetToken        String?      @unique
  resetTokenExpiry  DateTime?

  //activity logs
  activity_logs ActivityLog[]

  //for oic assignment
  oic_start   String?
  oic_end     String?

  //user created memos
  memosCreated     Memo[]         @relation("UserMemos")

  //disabled account hook
  disabled    Boolean   @default(false)

  // 🆕 Facility Reservation relations
  facilityRequests     FacilityReservation[]    @relation("FacilityRequestor")
  ocmEdits             FacilityReservation[]    @relation("OcmEditor")
  approvalsPerformed   FacilityApproval[]       @relation("ApprovalPerformer")
  facilityAssignments  FacilityAssignment[]     @relation("FacilityAssignee")

  packUpDoneReservations FacilityReservation[] @relation("PackUpDoneBy")
}

model Department {
  id        String   @id @default(uuid())
  code      String   @unique //(e.g., "ITO", "CSD", "HRD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  //pabalik na relationship to User (1 departament, maraming users ang pwede nakatali)
  users     User[]

  equipment            Equipment[]
}

model ActivityLog {
  id           String   @id @default(uuid())
  userId       String?  // Pwedeng null kung hindi pa naka-login (hal. Failed login attempt)
  email        String?  // Para madaling basahin kahit nabura na yung user
  action       String   // Halimbawa: "LOGIN_SUCCESS", "LOGOUT", "USER_CREATE", "DEPT_UPDATE", "CHANGE_PASSWORD"
  details      String?  // Mas madetalyeng kwento (e.g., "Created user: juan@email.com", "Updated Dept: ITO to IT_NEW")
  ipAddress    String?
  createdAt    DateTime @default(now())

  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

enum Role {
  Staff
  DepartmentHead
  SuperUser
  Admin
  Faculty
}

enum SystemBranch {
  MAIN
  IMUS
  NASTECH
  SHS
}

// notif table (useswr for fetch)
model Notification {
  id          String   @id @default(uuid())
  title       String
  message     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  // notif receipient
  recipientId String
  recipient   User     @relation("notif_rcpt", fields: [recipientId], references: [id], onDelete: Cascade)

  // notif sender
  senderId    String
  sender      User     @relation("notif_sndr", fields: [senderId], references: [id], onDelete: Cascade)
}

model LoginLog {
  id           Int          @id @default(autoincrement())
  userId       String?
  email        String?
  status       LoginStatus  @default(SUCCESS)
  ip_address   String?
  attempted_at DateTime     @default(now())

  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum LoginStatus {
  SUCCESS
  FAILURE
}

enum MemoWorkflowStatus {
  DRAFT
  FOR_APPROVAL
  APPROVED
  CLOSED
}

model Memo {
  id              String                @id @default(uuid())
  referenceId     String                @unique // e.g., CS-2026-001
  subject         String                // Re1
  content         String                @db.Text
  priority        Priority              @default(ROUTINE) // ROUTINE, URGENT, RUSH
  purpose         Purpose               // FYI, SIGNATURE, ACTION, etc.
  
  senderId        String
  sender          User                  @relation("UserMemos", fields: [senderId], references: [id], onDelete: Restrict)

  senderName      String                // Staff/Head Name
  senderDept      String                // Department Name
  createdAt       DateTime              @default(now())
  deadlineAt      DateTime?             // +3 days kapag RUSH

  attachmentPaths String[]  @default([])

  status          MemoWorkflowStatus    @default(APPROVED)
  
  // Threading pointers
  parentMemoId    String?
  parentMemo      Memo?                 @relation("MemoHierarchy", fields: [parentMemoId], references: [id], onDelete: Cascade)
  replies         Memo[]                @relation("MemoHierarchy")
  rootMemoId      String?
  rootMemo        Memo?                 @relation("RootThread", fields: [rootMemoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  threadMembers   Memo[]                @relation("RootThread")

  // Tracking per department
  recipients      MemoRecipientStatus[]

  isRevisedByHead Boolean @default(false)
  
  resolutionMode ResolutionMode @default(NONE)
  
  history MemoHistory[]

  lastActivityAt DateTime @default(now())
  
  headNote         String?   @db.Text

  revisedSubject    String?    // Head's revised subject (null = no revision)
  revisedHeadNote   String?    @db.Text // Head's notes (null = no notes)

  @@index([senderId])
  @@index([createdAt])
  @@index([lastActivityAt])
  @@index([status])
}

enum ResolutionMode {
  NONE
  CONFIRMATION
}

enum Status {
    PENDING
    ACKNOWLEDGED
    COMPLETED
    PROCESSING
    DENIED
    CLOSED
    RESPONDED
}

model MemoRecipientStatus {

  id String @id @default(uuid())

  memoId String 

  memo Memo @relation(fields:[memoId], references:[id], onDelete:Cascade)

  departmentName String

  status Status @default(PENDING)

  acknowledgedById String?
  acknowledgedByName String?
  acknowledgedAt DateTime?

  processedAt DateTime?

  completedById String?
  completedByName String?
  completedAt DateTime?

  feedbackNote String? @db.Text

  senderConfirmationNote String?
  recipientConfirmationNote String?

  processedById String?
  processedByName String?

  deniedById String?
  deniedByName String?
  deniedAt DateTime?

  senderConfirmedById String?
  senderConfirmedByName String?
  senderConfirmedAt DateTime?

  recipientConfirmedById String?
  recipientConfirmedByName String?
  recipientConfirmedAt DateTime?

  closedById String?
  closedByName String?
  closedByRole String?
  closedAt DateTime?

  updatedAt DateTime @updatedAt

  lastActivityAt DateTime @default(now())

  isSenderClosing Boolean  @default(false)
  attachmentPaths String[]

  respondedAt DateTime?

  assignedToIds   String[]
  assignedToNames String[]
  assignedAt     DateTime?

  @@unique([memoId, departmentName])

  @@index([departmentName])
  @@index([status])
  }

enum Priority {
   ROUTINE
   URGENT
   RUSH
}

enum Purpose {
  FYI
  SIGNATURE
  ACTION
  COMMENTS
  APPROVAL
  REQUEST
}

model MemoHistory {

    id String @id @default(uuid())

    memoId String
    memo Memo @relation(fields:[memoId], references:[id], onDelete:Cascade)
    
    departmentName String?

    performedById String
    performedByName String

    actorRole MemoActorRole
    action MemoHistoryAction

    remarks String? @db.Text

    createdAt DateTime @default(now())

    @@index([memoId])
    @@index([createdAt])
}

enum MemoActorRole {
    SENDER
    RECIPIENT
    ADMIN
    SYSTEM
}

enum MemoHistoryAction {
    CREATED
    APPROVED
    DISAPPROVED
    ACKNOWLEDGED
    PROCESSING_STARTED
    PROCESSING_JOINED
    COMPLETED
    DENIED
    SENDER_CONFIRMED
    RECIPIENT_CONFIRMED
    CLOSED
    CLOSED_BY_RECIPIENT
    CLOSED_BY_SENDER
    REPLIED
    REVISED_BY_HEAD
    ASSIGNED
    REVERTED
}

// ====
// FRF
// ====

enum ReservationType {
  EMPLOYEE_ONLY
  WITH_STUDENTS
}

enum ReservationStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REVISION_REQUESTED
  REJECTED
  COMPLETED
  CANCELLED
  RESCHEDULE_PENDING
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  REVISION_REQUESTED
  ACKNOWLEDGED
}

model FacilityReservation {
  id                 String                       @id @default(uuid())
  referenceId        String                       @unique
  requestorId        String
  requestor          User                         @relation("FacilityRequestor", fields: [requestorId], references: [id], onDelete: Restrict)
  requestorDept      String

  type               ReservationType              @default(EMPLOYEE_ONLY)

  dates           FacilityReservationDate[]

  attendeesCount     Int                          @default(0)
  usageHours         Float?
  withCharge         Boolean?

  equipmentRequests  FacilityEquipmentRequest[]

  attachments        String[]                     @default([])
  requestorNotes     String?                      @db.Text

  status             ReservationStatus            @default(DRAFT)
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  eventName          String?

  approvals          FacilityApproval[]
  assignments        FacilityAssignment[]

  ocmEditedAt        DateTime?
  ocmEditedById      String?
  ocmEditedBy        User?                        @relation("OcmEditor", fields: [ocmEditedById], references: [id])

  isReschedule         Boolean?                @default(false)
  originalDates        Json?
  originalApprovals    Json?

  isVenueOnly          Boolean?               @default(false)

  packUpDoneAt       DateTime?
  packUpDoneById     String?
  packUpDoneBy       User?      @relation("PackUpDoneBy", fields: [packUpDoneById], references: [id], onDelete: SetNull)
  packUpDoneNotes    String?    @db.Text

  packUpDonePhotos   String[]  @default([])
  packUpDoneLocation String?

  @@index([status])
  @@index([requestorDept])
  @@index([createdAt])
}

model FacilityApproval {
  id                   String               @id @default(uuid())
  reservationId        String
  reservation          FacilityReservation  @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  departmentCode       String
  stepOrder            Int

  status               ApprovalStatus       @default(PENDING)

  performedById        String?
  performedBy          User?                @relation("ApprovalPerformer", fields: [performedById], references: [id])
  performedAt          DateTime?

  remarks              String?              @db.Text

  revisionRequestedAt  DateTime?
  revisionReason       String?              @db.Text

  acknowledgedAt       DateTime?

  @@unique([reservationId, departmentCode])
  @@index([status])
  @@index([departmentCode])
}

model FacilityAssignment {
  id                   String               @id @default(uuid())
  reservationId        String
  reservation          FacilityReservation  @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  userId               String
  user                 User                 @relation("FacilityAssignee", fields: [userId], references: [id])

  dutyStart            DateTime
  dutyEnd              DateTime

  dutyType             DutyType             @default(SETUP)

  createdAt            DateTime             @default(now())

  notes                String?

  isOvertime        Boolean       @default(false)

  @@index([userId])
  @@index([reservationId])
}

enum EventPlaceCategory {
  REGULAR
  CATEGORY_1
  CATEGORY_2
  VIP
}

model EventPlace {
  id                   String               @id @default(uuid())
  name                 String               @unique
  isActive             Boolean              @default(true)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  branch               SystemBranch         @default(MAIN)
  hasSetItems          Boolean              @default(false)
  notes                String?              @db.Text

  dateReservations     FacilityReservationDate[]

  category             EventPlaceCategory   @default(REGULAR)

  equipment            EquipmentPlace[]
}

model Equipment {
  id                   String               @id @default(uuid())
  name                 String
  departmentCode       String
  department           Department           @relation(fields: [departmentCode], references: [code], onDelete: Restrict)
  isSingleItem         Boolean              @default(false)
  quantityAvailable    Int                  @default(0)
  quantityReserved     Int                  @default(0)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  branch               SystemBranch?        @default(MAIN)

  places               EquipmentPlace[]

  equipmentRequests    FacilityEquipmentRequest[]

  @@unique([name, departmentCode, branch])
  @@index([departmentCode])
  @@index([branch])
}

model EquipmentPlace {
  equipmentId          String
  placeId              String

  equipment            Equipment           @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  place                EventPlace          @relation(fields: [placeId], references: [id], onDelete: Cascade)

  createdAt            DateTime            @default(now())

  isBundled            Boolean             @default(false)

  @@id([equipmentId, placeId])
  @@index([placeId])
  @@index([equipmentId])
}

model FacilityEquipmentRequest {
  id                   String               @id @default(uuid())
  reservationId        String
  reservation          FacilityReservation  @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  equipmentId          String
  equipment            Equipment            @relation(fields: [equipmentId], references: [id])

  quantityRequested    Int                  @default(1)

  @@unique([reservationId, equipmentId])
}

model FacilityReservationDate {
  id                String   @id @default(uuid())
  reservationId     String
  reservation       FacilityReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  
  date              DateTime   // the actual date
  setupTime         DateTime   // starting time
  eventStart        DateTime   // actual time start
  eventEnd          DateTime   // time end
  teardownTime      DateTime   // actual time end

  placeId           String?
  place             EventPlace? @relation(fields: [placeId], references: [id])
  placeOther        String?
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  @@unique([reservationId, date])
  @@index([reservationId])
}

enum DutyType {
  SETUP
  TEARDOWN
  OPERATOR
  ASSISTANT
}

model FormSettings {
  id                     String   @id @default("single")
  minAdvanceDaysRegular  Int      @default(7)
  minAdvanceDaysVIP      Int      @default(1)
  maxEventsPerDay        Int      @default(2)

  minRescheduleDays      Int      @default(3)

  enableVipMode            Boolean @default(true)
  
  updatedAt              DateTime @updatedAt
  updatedBy              String?
}