// This is your Prisma schema file,
// learn more about it in the docs: npx prisma generate

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid()) // Random secure ID (UUID)
  employee_id   String
  email         String         @unique
  password      String
  fname         String
  lname         String
  role          Role           @default(Staff)
  branch        SystemBranch   @default(MAIN)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  //department relations
  departmentCode  String
  department      Department     @relation(fields: [departmentCode], references: [code], onDelete: Restrict, onUpdate: Cascade)

  //notif relations
  received_notif  Notification[] @relation("notif_rcpt")
  sent_notif      Notification[] @relation("notif_sndr")

  //login sessions
  last_login        DateTime?
  login_logs        LoginLog[]

  //forgot password flag
  forgot_password   Boolean      @default(false)

  //activity logs
  activity_logs ActivityLog[]

  //for oic assignment
  oic_start   String?
  oic_end     String?
}

model Department {
  id        String   @id @default(uuid())
  code      String   @unique //(e.g., "ITO", "CSD", "HRD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  //pabalik na relationship to User (1 departament, maraming users ang pwede nakatali)
  users     User[]
}

model ActivityLog {
  id           String   @id @default(uuid())
  userId       String?  // Pwedeng null kung hindi pa naka-login (hal. Failed login attempt)
  email        String?  // Para madaling basahin kahit nabura na yung user
  action       String   // Halimbawa: "LOGIN_SUCCESS", "LOGOUT", "USER_CREATE", "DEPT_UPDATE", "CHANGE_PASSWORD"
  details      String?  // Mas madetalyeng kwento (e.g., "Created user: juan@email.com", "Updated Dept: ITO to IT_NEW")
  ipAddress    String?
  createdAt    DateTime @default(now())

  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

enum Role {
  Staff
  DepartmentHead
  SuperUser
  Admin
}

enum SystemBranch {
  MAIN
  IMUS
  NASTECH
  SHS
}

// notif table (useswr for fetch)
model Notification {
  id          String   @id @default(uuid())
  title       String
  message     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  // notif receipient
  recipientId String
  recipient   User     @relation("notif_rcpt", fields: [recipientId], references: [id], onDelete: Cascade)

  // notif sender
  senderId    String
  sender      User     @relation("notif_sndr", fields: [senderId], references: [id], onDelete: Cascade)
}

model LoginLog {
  id           Int          @id @default(autoincrement())
  userId       String?
  email        String?
  status       LoginStatus  @default(SUCCESS)
  ip_address   String?
  attempted_at DateTime     @default(now())

  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum LoginStatus {
  SUCCESS
  FAILURE
}

enum MemoWorkflowStatus {
  FOR_APPROVAL
  APPROVED
}

model Memo {
  id              String                @id @default(uuid())
  referenceId     String                @unique // e.g., CS-2026-001
  subject         String                // Re1
  content         String                @db.Text
  priority        Priority              @default(ROUTINE) // ROUTINE, URGENT, RUSH
  purpose         Purpose               // FYI, SIGNATURE, ACTION, etc.
  senderId        String
  senderName      String                // Staff/Head Name
  senderDept      String                // Department Name
  createdAt       DateTime              @default(now())
  deadlineAt      DateTime?             // +3 days kapag RUSH

  attachmentPath  String?               // Optional PDF/Image link na ise-save sa server disk

  status          MemoWorkflowStatus    @default(APPROVED)
  
  // Threading pointers
  parentMemoId    String?
  parentMemo      Memo?                 @relation("MemoHierarchy", fields: [parentMemoId], references: [id], onDelete: Cascade)
  replies         Memo[]                @relation("MemoHierarchy")
  rootMemoId      String?
  rootMemo        Memo?                 @relation("RootThread", fields: [rootMemoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  threadMembers   Memo[]                @relation("RootThread")

  // Tracking per department
  recipients      MemoRecipientStatus[]

  isRevisedByHead Boolean @default(false) // Ito ang indicator natin
}

model MemoRecipientStatus {
  id              String    @id @default(uuid())
  memoId          String
  memo            Memo      @relation(fields: [memoId], references: [id], onDelete: Cascade)
  departmentName  String    // e.g., "REGISTRAR", "CASHIER"
  status          Status    @default(PENDING) // PENDING, ACKNOWLEDGED, RESPONDED
  acknowledgedBy  String?   // Pangalan ng Head

  // 🎯 Mga Bagong Field para sa Workflow Extensions
  processedBy     String?   // Pangalan ng staff/head na nag-set sa In Progress
  processedAt     DateTime?
  
  deniedBy        String?   // Kung sino ang nag-deny
  deniedAt        DateTime?
  
  // 🎯 Dito natin ilalagay ang dahilan ng Denied o Karagdagang Note
  feedbackNote    String?   @db.Text // Pwedeng Return Reason o Resolution Note

  acknowledgedAt  DateTime?
  respondedAt     DateTime?
}

enum Priority {
   ROUTINE
   URGENT
   RUSH 
}

enum Purpose { 
  FYI
  SIGNATURE
  ACTION
  COMMENTS
  APPROVAL
  REQUEST 
}

enum Status {
   PENDING
   ACKNOWLEDGED
   RESPONDED
   PROCESSING
   DENIED
}