// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid()) // Random secure ID (UUID)
  employee_id   String         @unique
  email         String
  password      String
  fname         String
  lname         String
  role          Role           @default(Staff)
  department    Department     @default(ITO)
  branch        SystemBranch   @default(MAIN)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  //notif relations
  received_notif Notification[] @relation("notif_rcpt")
  sent_notif     Notification[] @relation("notif_sndr")

  //login sessions
  last_login       DateTime?

  login_logs       LoginLog[]
}

enum Role {
  Staff
  CoAdmin
  DepartmentHead
  SuperUser
}

enum SystemBranch {
  MAIN
  IMUS
  NASTECH
  SHS
}

enum Department {
  AMT
  ARCHITECTURE
  BUSINESS
  CJED
  CSD
  EDPSYCOMM
  GENED
  NSTP
  ENGINEERING
  HEROES
  HTMD
  RESEARCH
  SSMT
  ACAD
  ACCOUNTING
  OP
  OCMCDO
  HRD
  GUIDANCE
  OSA
  HSO
  ITJPO
  ITO
  LIBRARY
  PRD
  PSMOFMO
  REGISTRAR
  SAFETYSECURITY
  //FMO AND PRODUCTION UNSURE PA
}

// notif table (useswr for fetch)
model Notification {
  id          String   @id @default(uuid())
  title       String
  message     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  // notif receipient
  recipientId String
  recipient   User     @relation("notif_rcpt", fields: [recipientId], references: [id], onDelete: Cascade)

  // notif sender
  senderId    String
  sender      User     @relation("notif_sndr", fields: [senderId], references: [id], onDelete: Cascade)
}

model LoginLog {
  id           Int          @id @default(autoincrement())
  userId  String?
  email        String?
  status       LoginStatus  @default(SUCCESS)
  ip_address   String?
  attempted_at DateTime     @default(now())

  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum LoginStatus {
  SUCCESS
  FAILURE
}